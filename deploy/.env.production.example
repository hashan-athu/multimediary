# ─────────────────────────────────────────────────────────────────────────────
# .env.production — Oracle VM environment
# Copy this file to /opt/multimediary/.env.production and fill in all values.
# NEVER commit the real .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Rails ─────────────────────────────────────────────────────────────────────
# Contents of backend/config/master.key  (also injected automatically by CI)
RAILS_MASTER_KEY=

# ── PostgreSQL (shared by both services in docker-compose.prod.yml) ───────────
# The "db" Docker service uses these to initialise the postgres superuser.
POSTGRES_USER=multimediary
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=multimediary_production
POSTGRES_CACHE_DB=multimediary_cache
POSTGRES_QUEUE_DB=multimediary_queue
POSTGRES_CABLE_DB=multimediary_cable

# DATABASE_URL, CACHE_DATABASE_URL, QUEUE_DATABASE_URL, CABLE_DATABASE_URL
# are constructed automatically in docker-compose.prod.yml from the vars above.
# Do NOT define them here unless you want to override (e.g., external DB host).

# ── TMDb API ──────────────────────────────────────────────────────────────────
TMDB_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel deployment URLs).
# Add both preview and production URLs.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app

# ── Optional tuning ───────────────────────────────────────────────────────────
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2
# JOB_CONCURRENCY=3
# RAILS_LOG_LEVEL=info
