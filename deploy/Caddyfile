{$BACKEND_DOMAIN} {
    # Documentation — Nginx serving the static Docusaurus build
    handle /docs/* {
        reverse_proxy docs:80
    }

    # Rails API — everything else
    handle {
        reverse_proxy backend:80
    }

    encode gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        # Allow docs to be embedded in iframes from the same origin
        X-Frame-Options "SAMEORIGIN"
    }

    log {
        output stderr
        format console
        level INFO
    }
}
