{"parameters":[{"in":"query","name":"page","schema":{"type":"integer","default":1}},{"in":"query","name":"per_page","schema":{"type":"integer","default":25}},{"in":"query","name":"sort","schema":{"type":"string","example":"name"},"description":"Column to sort by. Must be in the Movie ransackable_attributes allowlist."},{"in":"query","name":"direction","schema":{"type":"string","enum":["asc","desc"],"default":"desc"}},{"in":"query","name":"q[name_cont]","schema":{"type":"string"},"description":"Name contains value"},{"in":"query","name":"q[year_eq]","schema":{"type":"integer"},"description":"Exact year match"},{"in":"query","name":"q[language_cont]","schema":{"type":"string"}},{"in":"query","name":"q[s]","schema":{"type":"string","example":"year desc"},"description":"Ransack sort (alternative to sort + direction params)"}]}